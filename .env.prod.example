# =============================================================================
# 智联生活 · 生产环境变量模板
#
# 使用方法（在服务器上）：
#   cp .env.prod.example .env.prod
#   vim .env.prod            # 修改下面所有 CHANGE_ME 的值为强密码/随机串
#   chmod 600 .env.prod      # 收紧权限，避免被同机其它用户读到
#
# 生成强随机值（服务器上执行）：
#   openssl rand -base64 24        # 生成一个 32 位左右的随机串
#
# 注意：.env.prod 已被 .gitignore 忽略，切勿提交到代码仓库
# =============================================================================

# ---------- 镜像版本（发新版时递增，便于回滚） ----------
APP_VERSION=2.0.0

# ---------- 对外端口（阿里云安全组需放行该端口） ----------
HTTP_PORT=80

# ---------- MySQL ----------
MYSQL_DATABASE=smartlife
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_strong_password

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ---------- RabbitMQ ----------
RABBIT_USER=smartlife
RABBIT_PASSWORD=CHANGE_ME_rabbitmq_strong_password

# ---------- JWT 密钥（务必 >= 32 字节；更换后所有已登录用户需重新登录） ----------
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes_long_random_string

# ---------- 秒杀实现方案：true=Lua+MQ（默认） false=Redisson 锁 ----------
SECKILL_LUA_ENABLED=true

# ---------- 后端 JVM 参数（按服务器内存调整：2C4G 建议保持默认） ----------
BACKEND_JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# ---------- 接口文档（生产建议 false，需要调试时临时改 true 再重启 backend） ----------
KNIFE4J_ENABLE=false
